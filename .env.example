# Persistence: local (default, zero-cost JSON) or supabase.
PERSISTENCE_DRIVER=local

# OpenAI — optional. Server-side only. Leave empty for zero-cost deterministic agents.
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase — browser/auth values. A publishable key is intentionally public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional future Temporal deployment. V0.2 does not require Temporal Cloud.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

# Optional override. Defaults to .data/personal-ai-os.json
LOCAL_DATA_PATH=
